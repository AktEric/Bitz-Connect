{$DOMAIN} {
	encode gzip

	# Uploads (vídeos etc.) — acompanha upload_max_filesize/post_max_size do php.ini
	request_body {
		max_size 205MB
	}

	# API Laravel — tudo em /api vai pro PHP-FPM via fastcgi
	@api path /api/*
	handle @api {
		root * /var/www/html/public
		php_fastcgi php:9000
	}

	# Storage — arquivos públicos do Laravel (storage:link)
	@storage path /storage/*
	handle @storage {
		root * /var/www/html/public
		file_server
		header Cache-Control "public, max-age=604800, immutable"
	}

	# Frontend — build estático do Vite, SPA fallback pro index.html
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
