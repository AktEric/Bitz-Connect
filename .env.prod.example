# Variáveis usadas pelo docker-compose.prod.yml (não confundir com backend/.env)
# Copie para .env.prod e preencha antes de rodar ./deploy.sh

DOMAIN=seudominio.com.br
DB_DATABASE=hotelconnect
DB_USERNAME=hotelconnect
DB_PASSWORD=troque_esta_senha

# Backup (serviço "backup"): senha para criptografar as cópias — guarde-a FORA do servidor.
BACKUP_PASSPHRASE=troque_por_uma_frase_longa
BACKUP_RETENTION_DAYS=14
