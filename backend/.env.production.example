APP_NAME="Bitz Connect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://SEUDOMINIO.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hotelconnect
DB_USERNAME=hotelconnect
DB_PASSWORD=TROQUE_ESTA_SENHA

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=SEUDOMINIO.com.br
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=hotelconnect_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail REAL (convites e recuperação de senha). Use SES, Postmark, Mailgun, SendGrid…
# Configure SPF, DKIM e DMARC no domínio de envio, senão os e-mails caem no spam.
MAIL_MAILER=smtp
MAIL_HOST=smtp.seuprovedor.com
MAIL_PORT=587
MAIL_USERNAME=TROQUE
MAIL_PASSWORD=TROQUE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@hotelconnect.com.br"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=SEUDOMINIO.com.br

# Segurança
# Atrás de Cloudflare/balanceador: "*" ou lista de IPs/CIDRs. Necessário para gravar o IP real no ponto.
# Deixe vazio se o Caddy recebe o tráfego direto da internet.
TRUSTED_PROXIES=
# Origens permitidas no CORS (padrão: o próprio APP_URL).
CORS_ALLOWED_ORIGINS=

# Conta administrativa da plataforma (só usada por "php artisan db:seed --class=AdminUserSeeder").
# Em produção o seeder EXIGE estas variáveis (senha com 12+ caracteres) e aborta sem elas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
